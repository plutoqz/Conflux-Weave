{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflux-weave.document-assets.v1",
  "title": "DocumentAssetsManifest",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "source_snapshot_id",
    "source_artifact_id",
    "generated_at",
    "asset_count",
    "unique_content_count",
    "status_counts",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "conflux-weave.document-assets.v1"
    },
    "document_id": {
      "type": "string"
    },
    "source_snapshot_id": {
      "type": "string"
    },
    "source_artifact_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "asset_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique_content_count": {
      "type": "integer",
      "minimum": 0
    },
    "status_counts": {
      "type": "object",
      "required": [
        "extracted",
        "degraded",
        "failed",
        "duplicate"
      ],
      "properties": {
        "extracted": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "conflux-weave.document-asset.v1.json"
      }
    }
  }
}
