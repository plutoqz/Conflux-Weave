# Copy this file to the ignored .env only when a separately authorized live Run is needed.
# The offline-smoke command does not read these values and makes no external calls.
CONFLUX_WEAVE_PROVIDER_BASE_URL=https://provider.example/v1
CONFLUX_WEAVE_PROVIDER_API_KEY=replace-with-local-secret
CONFLUX_WEAVE_PROVIDER_MODEL=replace-with-model-id
CONFLUX_WEAVE_PROVIDER_ENGINE_MODEL=replace-with-engine-model-id
TAVILY_API_KEY=replace-with-tavily-key
# Optional: gateway/proxy endpoint mirroring the Tavily /search API
# (official endpoint https://api.tavily.com/search is used when unset).
TAVILY_BASE_URL=https://api.tavily.com/search
